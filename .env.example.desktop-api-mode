# 桌面端 API 调用模式配置（客户端安装版）
# Desktop API Mode Configuration (Installed Client)

# 构建时控制：直连 API vs pipe 优先
# Build-time control: Direct API vs pipe-first
# VITE_EVOFLOW_DESKTOP_DIRECT_API=0     # 强制 pipe 优先（不推荐，回到 377ms 404 问题）
# VITE_EVOFLOW_DESKTOP_DIRECT_API=1     # 强制直连 API（推荐，默认）
#
# VITE_EVOFLOW_DESKTOP_DIRECT_API=0     # Force pipe-first (not recommended, brings back 377ms 404 issue)
# VITE_EVOFLOW_DESKTOP_DIRECT_API=1     # Force direct API (recommended, default)

# 运行时控制：localStorage 动态改
# Runtime control: toggle via localStorage in DevTools Console
#
# 强制优先 pipe（调试用）：
#   localStorage.setItem('EVOFLOW_DESKTOP_DIRECT_API','0')
#
# 恢复直连 API（默认）：
#   localStorage.setItem('EVOFLOW_DESKTOP_DIRECT_API','1')
#   或删除该键：
#   localStorage.removeItem('EVOFLOW_DESKTOP_DIRECT_API')
#
# 查看当前模式：
#   localStorage.getItem('EVOFLOW_DESKTOP_DIRECT_API')
#
# Force pipe-first (debugging):
#   localStorage.setItem('EVOFLOW_DESKTOP_DIRECT_API','0')
#
# Restore direct API (default):
#   localStorage.setItem('EVOFLOW_DESKTOP_DIRECT_API','1')
#   or remove the key:
#   localStorage.removeItem('EVOFLOW_DESKTOP_DIRECT_API')
#
# Check current mode:
#   localStorage.getItem('EVOFLOW_DESKTOP_DIRECT_API')

# 旧配置（仍保留兼容）：
# Legacy config (still supported for backward compatibility):
# localStorage.setItem('evoflow-desktop-pipe-chat','1')      # 强制 pipe for /runs/stream
# localStorage.setItem('evoflow-desktop-pipe-chat','0')      # 强制 webview HTTP

